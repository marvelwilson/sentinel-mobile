NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./data/torquex.sqlite
# Public site origin used in tracking emails. Use HTTPS in production.
PUBLIC_BASE_URL=

# Enable the GTranslate widget after configuring a suitable commercial plan.
GTRANSLATE_ENABLED=false

# Bootstrap the first administrator. No default admin account is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# GoUrl supported cryptocurrency box credentials. GoUrl's listed coins do not include USDT.
GOURL_PUBLIC_KEY=
GOURL_PRIVATE_KEY=
GOURL_COIN=bitcoin

# SMTP settings for account verification, contact receipts, orders and tracking emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
